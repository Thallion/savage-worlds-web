# Kopieren nach .env und Werte setzen:  cp .env.example .env
#
# JWT-Signaturschlüssel — für den geteilten Betrieb unbedingt setzen!
# Vorschlag zum Erzeugen:  openssl rand -hex 32
CHARGEN_SECRET_KEY=change-me-in-production

# Nur für festen Cloudflare-Tunnel (named tunnel) nötig — sonst leer lassen.
# TUNNEL_TOKEN=
